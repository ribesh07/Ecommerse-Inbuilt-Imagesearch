APP_ENV=development
DATABASE_URL=postgresql+asyncpg://sukilo:sukilo@postgres:5432/sukilo

JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
PUBLIC_BASE_URL=http://localhost:8000

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=8388608

IMAGE_SEARCH_URL=http://host.docker.internal:8080
IMAGE_SEARCH_INTERNAL_TOKEN=change-me-internal-token
IMAGE_SEARCH_TIMEOUT_SECONDS=30

MODEL_VERSION=clip-vit-b-32-v1
CLIP_EMBEDDING_DIM=512

ADMIN_EMAIL=admin@sukilo.local
ADMIN_PASSWORD=changeme-admin

SEED_DEMO=true
ALLOWLISTED_IMAGE_HOSTS=127.0.0.1,localhost,backend