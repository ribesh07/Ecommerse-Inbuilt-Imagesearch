generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Storefront admin / API user. Customer storefront auth is not required for catalog browsing.
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String   @default("admin")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Brand {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  logoUrl      String?   @map("logo_url")
  description  String?
  products     Product[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Category {
  id           Int        @id @default(autoincrement())
  parentId     Int?       @map("parent_id")
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?    @map("image_url")
  level        Int        @default(0)
  products     Product[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@map("categories")
}

model Vendor {
  id           Int             @id @default(autoincrement())
  name         String
  slug         String          @unique
  email        String?
  phone        String?
  logoUrl      String?         @map("logo_url")
  countryCode  String?         @map("country_code")
  offers       ProductVendor[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("vendors")
}

/// status: 1 = published/active, 0 = unpublished, 2 = archived. Soft delete via deletedAt.
model Product {
  id                Int                   @id @default(autoincrement())
  name              String
  slug              String                @unique
  sku               String                @unique
  barcode           String?
  shortDescription  String?               @map("short_description")
  description       String?
  price             Decimal               @db.Decimal(12, 2)
  comparePrice      Decimal?              @map("compare_price") @db.Decimal(12, 2)
  stock             Int                   @default(0)
  rating            Decimal               @default(0) @db.Decimal(3, 2)
  reviewCount       Int                   @default(0) @map("review_count")
  weight            Decimal?              @db.Decimal(10, 3)
  status            Int                   @default(1)
  deletedAt         DateTime?             @map("deleted_at")
  brandId           Int?                  @map("brand_id")
  brand             Brand?                @relation(fields: [brandId], references: [id])
  categoryId        Int?                  @map("category_id")
  category          Category?             @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  prices            ProductPrice[]
  descriptions      ProductDescription[]
  specifications    ProductSpecification[]
  variants          ProductVariant[]
  vendors           ProductVendor[]
  reviews           Review[]
  embeddings        ProductImageEmbedding[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([status, deletedAt])
  @@index([brandId])
  @@index([categoryId])
  @@index([barcode])
  @@map("products")
}

model ProductImage {
  id            Int                      @id @default(autoincrement())
  productId     Int                      @map("product_id")
  product       Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl      String                   @map("image_url")
  thumbnailUrl  String                   @map("thumbnail_url")
  altText       String?                  @map("alt_text")
  sortOrder     Int                      @default(0) @map("sort_order")
  isPrimary     Boolean                  @default(false) @map("is_primary")
  contentHash   String?                  @map("content_hash")
  embeddings    ProductImageEmbedding[]
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_images")
}

model ProductPrice {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryCode   String   @map("country_code")
  currencyCode  String   @map("currency_code")
  price         Decimal  @db.Decimal(12, 2)
  comparePrice  Decimal? @map("compare_price") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")

  @@unique([productId, countryCode])
  @@map("product_prices")
}

model ProductDescription {
  id                 Int     @id @default(autoincrement())
  productId          Int     @map("product_id")
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  languageCode       String  @map("language_code")
  title              String
  shortDescription   String  @map("short_description")
  description        String

  @@unique([productId, languageCode])
  @@map("product_descriptions")
}

model ProductSpecification {
  id                 Int     @id @default(autoincrement())
  productId          Int     @map("product_id")
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  specificationName  String  @map("specification_name")
  specificationValue String  @map("specification_value")
  languageCode       String  @map("language_code")
  sortOrder          Int     @default(0) @map("sort_order")

  @@map("product_specifications")
}

model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  barcode      String?
  variantName  String   @map("variant_name")
  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @map("compare_price") @db.Decimal(12, 2)
  stock        Int      @default(0)
  status       Int      @default(1)
  attributes   Json     @default("[]")

  @@index([barcode])
  @@map("product_variants")
}

model ProductVendor {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  Int     @map("vendor_id")
  vendor    Vendor  @relation(fields: [vendorId], references: [id])
  vendorSku String  @map("vendor_sku")
  price     Decimal @db.Decimal(12, 2)
  stock     Int     @default(0)

  @@unique([productId, vendorId])
  @@map("product_vendors")
}

model Review {
  id                 Int      @id @default(autoincrement())
  productId          Int      @map("product_id")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int
  title              String
  review             String
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("reviews")
}

/// CLIP vectors live here, not on products. status: PENDING | INDEXED | FAILED
model ProductImageEmbedding {
  id             Int          @id @default(autoincrement())
  productId      Int          @map("product_id")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productImageId Int          @map("product_image_id")
  productImage   ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  imageUrl       String       @map("image_url")
  imageHash      String       @map("image_hash")
  modelVersion   String       @map("model_version")
  status         String       @default("PENDING")
  errorMessage   String?      @map("error_message")
  /// pgvector column; dimension must match CLIP_EMBEDDING_DIM (512 for ViT-B/32).
  embedding      Unsupported("vector")?
  indexedAt      DateTime?    @map("indexed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([productImageId, modelVersion])
  @@index([productId, status])
  @@index([status, modelVersion])
  @@map("product_image_embeddings")
}
