APP_ENV=development
DATABASE_URL=postgresql+asyncpg://sukilo:sukilo@127.0.0.1:5432/sukilo
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=25000000

# Model-free image search (phash + color histogram). No external service required.
MODEL_VERSION=phash-color-v1
IMAGE_SEARCH_MIN_SIMILARITY=0.35
IMAGE_SEARCH_PHASH_WEIGHT=0.7
IMAGE_SEARCH_COLOR_WEIGHT=0.3

# Legacy external embedding service settings (no longer required; kept for compat).
IMAGE_SEARCH_URL=http://127.0.0.1:8080
IMAGE_SEARCH_INTERNAL_TOKEN=change-me-internal-token
IMAGE_SEARCH_TIMEOUT_SECONDS=30
CLIP_EMBEDDING_DIM=512

ADMIN_EMAIL=admin@sukilo.local
ADMIN_PASSWORD=changeme-admin
SEED_DEMO=true
ALLOWLISTED_IMAGE_HOSTS=127.0.0.1,localhost,backend
